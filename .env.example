# RevenueCat public SDK keys (https://app.revenuecat.com/)
# These are safe to ship in the client. Create one project with two app entries (iOS + Android)
# and copy the public API keys here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_REPLACE_ME
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_REPLACE_ME

# Set to "1" to bypass the paywall locally during development.
EXPO_PUBLIC_BYPASS_PAYWALL=1
